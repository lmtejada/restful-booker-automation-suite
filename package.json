{
    "name": "restful-booker-automation-suite",
    "version": "1.0.0",
    "description": "API testing suite for Restful Booker — Postman/Newman, Playwright, and Pact contract testing, with Allure reporting.",
    "author": "Laura Tejada",
    "license": "ISC",
    "scripts": {
        "lint": "npx eslint .",
        "lint:fix": "npx eslint . --fix",
        "format": "npx prettier --write .",
        "test": "npx playwright test",
        "test:debug": "npx playwright test --debug",
        "test:smoke": "npx playwright test --grep @smoke",
        "test:regression": "npx playwright test --grep @regression",
        "test:api": "npx playwright test --grep @api",
        "test:issues": "npx playwright test --grep @issues",
        "test:integration": "npx playwright test --grep @integration",
        "test:api-suite": "npx playwright test --project=\"Playwright: restful-booker-api\"",
        "test:contract": "npx playwright test --grep @contract",
        "report": "npx playwright show-report",
        "typecheck": "tsc --noEmit",
        "prepare": "husky",
        "newman:run": "newman run src/collections/restful-booker.postman_collection.json -e src/collections/environment.json",
        "newman:verbose": "newman run src/collections/restful-booker.postman_collection.json -e src/collections/environment.json --verbose",
        "newman:bail": "newman run src/collections/restful-booker.postman_collection.json -e src/collections/environment.json --bail",
        "newman:html": "newman run src/collections/restful-booker.postman_collection.json -e src/collections/environment.json -r htmlextra --reporter-htmlextra-export reports/newman/report.html",
        "newman:allure": "newman run src/collections/restful-booker.postman_collection.json -e src/collections/environment.json -r cli,allure --reporter-allure-resultsDir reports/allure-results",
        "allure:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
        "allure:open": "allure open reports/allure-report",
        "allure:report": "npm run allure:generate && npm run allure:open"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@faker-js/faker": "^10.6.0",
        "@pact-foundation/pact": "^16.5.0",
        "@playwright/test": "^1.61.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.1.1",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "allure-commandline": "^2.43.0",
        "allure-playwright": "^3.10.2",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.8",
        "newman": "^6.2.2",
        "newman-reporter-allure": "^3.11.0",
        "newman-reporter-htmlextra": "^1.23.1",
        "prettier": "^3.9.5",
        "typescript-eslint": "^8.64.0"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md}": [
            "prettier --write"
        ]
    }
}
