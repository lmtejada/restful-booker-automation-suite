        {
            "name": "Bookings - Create Booking",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "// Extract and store created booking ID",
                            "const responseData = pm.response.json();",
                            "const newBookingId = responseData.bookingid;",
                            "",
                            "pm.test(\"Booking creation returned generated booking id and booking data\", function () {",
                            "    pm.expect(responseData).to.have.property(\"bookingid\");",
                            "    pm.expect(newBookingId).to.be.a('number');",
                            "",
                            "    pm.environment.set(\"bookingId\", newBookingId);",
                            "",
                            "    pm.expect(responseData.booking).to.have.property(\"firstname\");",
                            "});",
                            "",
                            "// Query /booking list to verify the ID is present",
                            "const baseUrl = pm.environment.get(\"baseUrl\");",
                            "",
                            "pm.sendRequest(`${baseUrl}/booking`, function (err, res) {",
                            "    pm.test(\"Created ID is present in booking list\", function () {",
                            "        pm.expect(err).to.be.null;",
                            "        const bookingList = res.json();",
                            "        ",
                            "        // Search the returned array for our new bookingid",
                            "        const exists = bookingList.some(item => item.bookingid === newBookingId);",
                            "        pm.expect(exists).to.be.true;",
                            "    });",
                            "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    },
                    {
                        "key": "Accept",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"firstname\": \"Laura\",\n  \"lastname\": \"Tejada\",\n  \"totalprice\": 111,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2026-08-25\",\n    \"checkout\": \"2026-08-30\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{baseUrl}}/booking",
                    "host": ["{{baseUrl}}"],
                    "path": ["booking"]
                }
            },
            "response": []
        },
