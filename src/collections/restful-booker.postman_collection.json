        {
            "name": "Bookings - Delete Booking",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "const targetBookingId = pm.environment.get(\"bookingId\");",
                            "const baseUrl = pm.environment.get(\"baseUrl\");",
                            "",
                            "// Query /booking list to verify the ID has been removed",
                            "pm.sendRequest(`${baseUrl}/booking`, function (err, res) {",
                            "    pm.test(\"Deleted ID is no longer present in booking list\", function () {",
                            "        pm.expect(err).to.be.null;",
                            "        const bookingList = res.json();",
                            "        ",
                            "        // Assert the target ID is NOT in the list",
                            "        const exists = bookingList.some(item => item.bookingid == targetBookingId);",
                            "        pm.expect(exists).to.be.false;",
                            "    });",
                            "});"
                        ],
                        "type": "text/javascript",
                        "packages": {},
                        "requests": {}
                    }
                }
            ],
            "request": {
                "method": "DELETE",
                "header": [
                    {
                        "key": "Cookie",
                        "value": "token={{token}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/booking/:id",
                    "host": ["{{baseUrl}}"],
                    "path": ["booking", ":id"],
                    "variable": [
                        {
                            "key": "id",
                            "value": "{{bookingId}}"
                        }
                    ]
                }
            },
            "response": []
        }
