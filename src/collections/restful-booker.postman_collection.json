    "event": [
        {
            "listen": "prerequest",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                    "// Skip token generation if hitting the /auth endpoint directly",
                    "if (pm.request.url.getPath().includes('auth')) {",
                    "    return;",
                    "}",
                    "",
                    "// Check if a token already exists in the environment",
                    "const existingToken = pm.environment.get(\"token\");",
                    "",
                    "// Request a fresh token",
                    "const baseUrl = pm.environment.get(\"baseUrl\");",
                    "",
                    "pm.sendRequest({",
                    "    url: `${baseUrl}/auth`,",
                    "    method: 'POST',",
                    "    header: {",
                    "        'Content-Type': 'application/json'",
                    "    },",
                    "    body: {",
                    "        mode: 'raw',",
                    "        raw: JSON.stringify({",
                    "            \"username\": pm.environment.get(\"admin_username\"),",
                    "            \"password\": pm.environment.get(\"admin_password\")",
                    "        })",
                    "    }",
                    "}, function (err, res) {",
                    "    if (err) {",
                    "        console.error(\"Failed to fetch auth token:\", err);",
                    "        return;",
                    "    }",
                    "",
                    "    const responseData = res.json();",
                    "    if (responseData && responseData.token) {",
                    "        pm.environment.set(\"token\", responseData.token);",
                    "        console.log(\"Fresh token generated and saved:\", responseData.token);",
                    "    } else {",
                    "        console.error(\"Auth response did not contain a valid token.\");",
                    "    }",
                    "});"
                ]
            }
        },
        {
            "listen": "test",
            "script": {
                "type": "text/javascript",
                "packages": {},
                "requests": {},
                "exec": [
                    "// Status Code Validation (Accepts 200 OK or 201 Created for REST conventions)",
                    "pm.test(\"Status code is 200 or 201\", function () {",
                    "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                    "});",
                    "",
                    "// Performance Target Constraint (< 2000 ms response time)",
                    "pm.test(\"Response time is under 2000ms\", function () {",
                    "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                    "});",
                    "",
                    "// Content-Type Header Format Constraints",
                    "pm.test(\"Content-Type header is present\", function () {",
                    "    pm.response.to.have.header(\"Content-Type\");",
                    "});",
                    "",
                    "// JSON Payload Verification (Applies to JSON endpoints)",
                    "if (pm.response.headers.get(\"Content-Type\") && pm.response.headers.get(\"Content-Type\").includes(\"application/json\")) {",
                    "    pm.test(\"Response body is valid JSON\", function () {",
                    "        const jsonData = pm.response.json();",
                    "        const isObjectOrArray = typeof jsonData === 'object' && jsonData !== null;",
                    "        pm.expect(isObjectOrArray).to.be.true;",
                    "    });",
                    "}"
                ]
            }
        }
    ]
